# true keeps the app in synthetic Demo Mode by default.
VITE_DEMO_MODE=true

# FastAPI base URL for the future backend integration.
VITE_API_BASE_URL=http://localhost:8000

# Display version only; do not put secrets in Vite environment variables.
VITE_APP_VERSION=0.1.0-demo

# --- Backend (FastAPI) — set in the backend service's private environment, never in VITE_ vars ---
# Hosted: the managed PostgreSQL connection string. Never commit a real value.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Hosted: refuse to start unless DATABASE_URL points to PostgreSQL.
# VITALGUARD_REQUIRE_POSTGRES=true
# Local only: SQLite file used when DATABASE_URL is unset (not durable on hosted ephemeral disks).
# VITALGUARD_DB_PATH=backend/vitalguard_demo.sqlite3
# Optional PostgreSQL pool/timeout tuning (defaults shown).
# VITALGUARD_DB_POOL_SIZE=5
# VITALGUARD_DB_MAX_OVERFLOW=5
# VITALGUARD_DB_POOL_TIMEOUT_SECONDS=10
# VITALGUARD_DB_POOL_RECYCLE_SECONDS=1800
# VITALGUARD_DB_CONNECT_TIMEOUT_SECONDS=10
# VITALGUARD_DB_STATEMENT_TIMEOUT_MS=15000
# VITALGUARD_DB_IDLE_TX_TIMEOUT_MS=30000

# --- Live events across backend instances (see docs/SCALABILITY.md) ---
# auto: PostgreSQL LISTEN/NOTIFY when DATABASE_URL is PostgreSQL (cross-instance), otherwise
# in-process "memory" mode (single instance only). No extra broker service or secret is needed.
# VITALGUARD_EVENT_BROKER=auto
# Unique per instance (default: hostname-pid).
# VITALGUARD_INSTANCE_ID=api-1
# VITALGUARD_EVENT_POLL_SECONDS=2
# VITALGUARD_EVENT_GAP_TIMEOUT_SECONDS=60
# VITALGUARD_EVENT_RETENTION_HOURS=168
# VITALGUARD_EVENT_LISTENER_STARTUP_TIMEOUT_SECONDS=5
# VITALGUARD_MAX_WEBSOCKETS=1000
# VITALGUARD_WEBSOCKET_SEND_TIMEOUT_SECONDS=2
# VITALGUARD_REQUEST_TIMEOUT_SECONDS=30

# --- Web Push (backend private environment only; see docs/WEB_PUSH.md) ---
# Generate with: python backend/scripts/generate_vapid_keys.py. Never commit the private key.
# VITALGUARD_VAPID_PRIVATE_KEY=
# VITALGUARD_VAPID_SUBJECT=mailto:operator@example.org
# Public base URL of this API for service-worker receipts (defaults to the request URL).
# VITALGUARD_PUBLIC_API_URL=https://vitalguard-risk-api.onrender.com
# VITALGUARD_PUSH_MAX_SUBSCRIPTIONS=1000
# VITALGUARD_PUSH_POLL_SECONDS=5

# --- Sign-in and roles (backend private environment only; see IMPLEMENTATION_REPORT.md) ---
# Signs the bearer tokens. Required for sessions to survive restarts and to work across instances.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# VITALGUARD_AUTH_SECRET=
# Shared password of the fictional demo accounts in backend/app/data/cohort.json.
# VITALGUARD_DEMO_PASSWORD=demo-access
# VITALGUARD_AUTH_TTL_SECONDS=43200
