  "version": "0.1.0",
  "description": "VitalGuard AI \u2014 AI-assisted clinical decision-support frontend prototype (demo, synthetic data only)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --pretty false && vite build",
